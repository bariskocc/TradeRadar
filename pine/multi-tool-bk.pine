//@version=6
indicator("Multi-Tool [BK]", overlay = true,
     max_lines_count  = 500,
     max_boxes_count  = 500,
     max_labels_count = 500)

// ============================================================
//  GENEL AYARLAR
// ============================================================
tz = "America/New_York"   // ICT killzone saatleri NY saatine göre

grpGen    = "Genel"
maxDays   = input.int(5, "Kaç günlük geçmiş gösterilsin", minval = 1, maxval = 30, group = grpGen)
maxLevels = input.int(60, "Maks. takip edilen seviye sayısı", minval = 4, maxval = 250, group = grpGen)

grpSweep    = "Likidite / Sweep"
sweepMethod = input.string("Wick (gölge)", "Sweep yöntemi",
     options = ["Wick (gölge)", "Close (kapanış)"], group = grpSweep)
keepSwept   = input.bool(true,  "Sweep olan çizgiler kalsın", group = grpSweep)
markSweep   = input.bool(true,  "Sweep noktasını işaretle",   group = grpSweep)
dimSwept    = input.bool(true,  "Sweep olan çizgiyi soldur",  group = grpSweep)

// ============================================================
//  KILLZONE TANIMLARI (NY saati - ICT standardı)
// ============================================================
grpKZ       = "Killzones"
showKZLabel = input.bool(false, "İsim etiketlerini göster", group = grpKZ)
showAsia    = input.bool(true, "Asia",     inline = "asia",  group = grpKZ)
colAsia     = input.color(color.new(color.blue,   90), "", inline = "asia",  group = grpKZ)
showLon     = input.bool(true, "London",   inline = "lon",   group = grpKZ)
colLon      = input.color(color.new(color.red,    90), "", inline = "lon",   group = grpKZ)
showAM      = input.bool(true, "NY AM",    inline = "am",    group = grpKZ)
colAM       = input.color(color.new(color.green,  90), "", inline = "am",    group = grpKZ)
showLunch   = input.bool(true, "NY Lunch", inline = "lunch", group = grpKZ)
colLunch    = input.color(color.new(color.yellow, 90), "", inline = "lunch", group = grpKZ)
showPM      = input.bool(true, "NY PM",    inline = "pm",    group = grpKZ)
colPM       = input.color(color.new(color.purple, 90), "", inline = "pm",    group = grpKZ)

// ============================================================
//  ÖNCEKİ GÜN HIGH/LOW (sadece 1 önceki gün)
// ============================================================
grpPD       = "Önceki Gün High/Low"
showPDHL    = input.bool(true,  "Göster",                   group = grpPD)
showPDLabel = input.bool(false, "İsim etiketlerini göster", group = grpPD)
colPDH      = input.color(color.red,   "PDH rengi", inline = "pd", group = grpPD)
colPDL      = input.color(color.green, "PDL rengi", inline = "pd", group = grpPD)
pdWidth     = input.int(2, "Çizgi kalınlığı", minval = 1, maxval = 4, group = grpPD)

// ============================================================
//  EMA'LAR  -  EMA 50 turuncu, EMA 200 mavi
// ============================================================
grpEMA   = "EMA"
showE20  = input.bool(true, "EMA 20",  inline = "e20", group = grpEMA)
lenE20   = input.int(20,  "", inline = "e20", minval = 1, group = grpEMA)
colE20   = input.color(color.aqua,    "", inline = "e20", group = grpEMA)
showE50  = input.bool(true, "EMA 50",  inline = "e50", group = grpEMA)
lenE50   = input.int(50,  "", inline = "e50", minval = 1, group = grpEMA)
colE50   = input.color(color.orange,  "", inline = "e50", group = grpEMA)
showE100 = input.bool(true, "EMA 100", inline = "e100", group = grpEMA)
lenE100  = input.int(100, "", inline = "e100", minval = 1, group = grpEMA)
colE100  = input.color(color.fuchsia, "", inline = "e100", group = grpEMA)
showE200 = input.bool(true, "EMA 200", inline = "e200", group = grpEMA)
lenE200  = input.int(200, "", inline = "e200", minval = 1, group = grpEMA)
colE200  = input.color(color.blue,    "", inline = "e200", group = grpEMA)

// ============================================================
//  NWOG / NDOG
// ============================================================
grpGap      = "NWOG / NDOG"
showNDOG    = input.bool(true, "NDOG (Günlük açılış gap)", group = grpGap)
colNDOG     = input.color(color.new(color.green, 80), "NDOG rengi", group = grpGap)
maxNDOG     = input.int(3, "Maks. NDOG adedi", minval = 1, maxval = 50, group = grpGap)
showNWOG    = input.bool(true, "NWOG (Haftalık açılış gap)", group = grpGap)
colNWOG     = input.color(color.new(color.yellow, 80), "NWOG rengi", group = grpGap)
maxNWOG     = input.int(3, "Maks. NWOG adedi", minval = 1, maxval = 50, group = grpGap)
showCE      = input.bool(true, "Orta çizgi (CE) göster", group = grpGap)
colCE       = input.color(color.new(color.white, 40), "CE rengi", group = grpGap)
showGapLbl  = input.bool(true, "Gap etiketlerini göster", group = grpGap)
lblColNDOG  = input.color(color.green,  "NDOG yazı rengi", group = grpGap)
lblColNWOG  = input.color(color.yellow, "NWOG yazı rengi", group = grpGap)

// ============================================================
//  SMT DIVERGENCE  --  (KAPALI: açmak için aşağıdaki yorumları kaldırın)
// ============================================================
// grpSMT        = "SMT Divergence"
// showSMT       = input.bool(false, "SMT göster", group = grpSMT)
// showBrokenSMT = input.bool(false, "Broken SMT'leri göster", group = grpSMT)
// smtAuto       = input.bool(true,  "Korele sembolü otomatik bul", group = grpSMT)
// smtManual     = input.symbol("XAGUSD", "Manuel karşılaştırma sembolü", group = grpSMT)
// smtLen        = input.int(5, "Pivot uzunluğu", minval = 1, maxval = 50, group = grpSMT)
// colSMTbear    = input.color(color.red,   "Bearish SMT (tepe) çizgi", group = grpSMT)
// colSMTbull    = input.color(color.green, "Bullish SMT (dip) çizgi",  group = grpSMT)
// smtWidth      = input.int(2, "Çizgi kalınlığı", minval = 1, maxval = 4, group = grpSMT)
// maxSMT        = input.int(20, "Maks. SMT adedi", minval = 1, maxval = 100, group = grpSMT)

// ============================================================
//  YARDIMCI: NY saatine göre verilen aralıkta mıyız?
// ============================================================
inSession(int startH, int startM, int endH, int endM) =>
    h   = hour(time, tz)
    m   = minute(time, tz)
    cur = h * 60 + m
    s   = startH * 60 + startM
    e   = endH   * 60 + endM
    e <= s ? (cur >= s or cur < e) : (cur >= s and cur < e)

withinHistory = (timenow - time) <= maxDays * 86400000
useWick       = sweepMethod == "Wick (gölge)"
kzAllowed     = timeframe.isintraday and timeframe.in_seconds() <= 900
emaAllowed    = timeframe.in_seconds() >= 300
pdAllowed     = timeframe.in_seconds() <= 86400
gapAllowed    = timeframe.in_seconds() <= 3600
transp        = color.new(color.white, 100)   // görünmez baloncuk

// ============================================================
//  OTOMATIK KORELE SEMBOL ÇÖZÜMÜ  --  (KAPALI: SMT ile birlikte açın)
// ============================================================
