// ============================================================
//  VERİ TİPLERİ
// ============================================================
type KZ
    bool  active = false
    box   bx     = na
    line  hi     = na
    line  lo     = na
    label lb     = na
    float h      = na
    float l      = na

type Level
    line   ln     = na
    label  mk     = na
    float  price  = na
    bool   isHigh = true
    bool   swept  = false
    color  col    = na

type Gap
    box   bx  = na
    line  ce  = na
    label lb  = na
    float mid = na

// type SMT
//     line  ln     = na
//     label lb     = na
//     float brk    = na
//     bool  bear   = true
//     bool  broken = false
//     color col    = na

var KZ kzAsia  = KZ.new()
var KZ kzLon   = KZ.new()
var KZ kzAM    = KZ.new()
var KZ kzLunch = KZ.new()
var KZ kzPM    = KZ.new()

var array<Level> levels = array.new<Level>()
var array<Gap>   ndogs  = array.new<Gap>()
var array<Gap>   nwogs  = array.new<Gap>()
// var array<SMT>   smts   = array.new<SMT>()

// ============================================================
//  Killzone seviyesini sweep-takibine ekle
// ============================================================
pushLevel(line ln, float p, bool isHigh, color col) =>
    array.push(levels, Level.new(ln, na, p, isHigh, false, col))
    if array.size(levels) > maxLevels
        Level old = array.shift(levels)
        if not na(old.ln)
            line.delete(old.ln)
        if not na(old.mk)
            label.delete(old.mk)

// ============================================================
//  Gap fonksiyonları
// ============================================================
addGap(array<Gap> arr, float a, float b, color col, bool ce, color ceCol, int maxN,
     string txt, bool showLbl, color lblCol) =>
    top = math.max(a, b)
    bot = math.min(a, b)
    mid = (top + bot) / 2
    bx  = box.new(bar_index, top, bar_index, bot, border_color = na, bgcolor = col)
    line ceLn = na
    if ce
        ceLn := line.new(bar_index, mid, bar_index, mid, color = ceCol, style = line.style_dashed, width = 1)
    label lb = na
    if showLbl
        lb := label.new(bar_index, mid, txt, style = label.style_label_right,
             color = transp, textcolor = lblCol, size = size.small)
    array.push(arr, Gap.new(bx, ceLn, lb, mid))
    if array.size(arr) > maxN
        Gap old = array.shift(arr)
        if not na(old.bx)
            box.delete(old.bx)
        if not na(old.ce)
            line.delete(old.ce)
        if not na(old.lb)
            label.delete(old.lb)

updGap(Gap g) =>
    box.set_right(g.bx, bar_index)
    if not na(g.ce)
        line.set_x2(g.ce, bar_index)
    if not na(g.lb)
        label.set_xy(g.lb, bar_index, g.mid)

extendGaps(array<Gap> arr, bool onlyLast) =>
    n = array.size(arr)
    if n > 0
        if onlyLast
            updGap(array.get(arr, n - 1))
        else
            for g in arr
                updGap(g)

// ============================================================
//  SMT ekle  --  (KAPALI: SMT ile birlikte açın)
// ============================================================
// addSMT(int x1, float y1, int x2, float y2, color col, bool bear, string txt, int maxN) =>
//     ln = line.new(x1, y1, x2, y2, color = col, width = smtWidth)
//     int   mx = int(math.round((x1 + x2) / 2))
//     float my = bear ? math.max(y1, y2) : math.min(y1, y2)
//     lb = label.new(mx, my, txt, style = bear ? label.style_label_down : label.style_label_up,
//          color = transp, textcolor = col, size = size.tiny)
//     array.push(smts, SMT.new(ln, lb, my, bear, false, col))
//     if array.size(smts) > maxN
//         SMT old = array.shift(smts)
//         if not na(old.ln)
//             line.delete(old.ln)
//         if not na(old.lb)
//             label.delete(old.lb)

// ============================================================
//  KILLZONE MOTORU
// ============================================================
drawKZ(KZ k, bool enabled, bool isIn, color col, string name) =>
    lineCol = color.new(col, 60)
    if enabled and withinHistory and kzAllowed
        if isIn and not k.active
            k.active := true
            k.h := high
            k.l := low
            k.bx := box.new(bar_index, high, bar_index, low, border_color = na, bgcolor = col)
            k.hi := line.new(bar_index, high, bar_index, high, color = lineCol, width = 1)
            k.lo := line.new(bar_index, low,  bar_index, low,  color = lineCol, width = 1)
            if showKZLabel
                k.lb := label.new(bar_index, high, name,
                     style = label.style_label_right, color = transp,
                     textcolor = color.new(col, 0), size = size.small)
        else if isIn and k.active
            k.h := math.max(k.h, high)
            k.l := math.min(k.l, low)
            box.set_right(k.bx, bar_index)
            box.set_top(k.bx, k.h)
            box.set_bottom(k.bx, k.l)
            line.set_xy2(k.hi, bar_index, k.h)
            line.set_y1(k.hi, k.h)
            line.set_xy2(k.lo, bar_index, k.l)
            line.set_y1(k.lo, k.l)
            if not na(k.lb)
                label.set_xy(k.lb, line.get_x1(k.hi), k.h)
        else if not isIn and k.active
            k.active := false
            pushLevel(k.hi, k.h, true,  lineCol)
            pushLevel(k.lo, k.l, false, lineCol)
            k.bx := na
            k.hi := na
            k.lo := na
            k.lb := na
    k

// ============================================================
//  ANA AKIŞ - Killzones
// ============================================================
kzAsia  := drawKZ(kzAsia,  showAsia,  inSession(20, 0, 0,  0),  colAsia,  "Asia")
kzLon   := drawKZ(kzLon,   showLon,   inSession(2,  0, 5,  0),  colLon,   "London")
kzAM    := drawKZ(kzAM,    showAM,    inSession(9,  30, 11, 0),  colAM,    "NY AM")
kzLunch := drawKZ(kzLunch, showLunch, inSession(12, 0, 13, 0),  colLunch, "NY Lunch")
kzPM    := drawKZ(kzPM,    showPM,    inSession(13, 30, 16, 0), colPM,    "NY PM")

// ============================================================
//  KILLZONE LİKİDİTE TAKİBİ
// ============================================================
int i = 0
while i < array.size(levels)
    Level lv = array.get(levels, i)
    if not lv.swept
        bool sweep = lv.isHigh ?
             (useWick ? high >= lv.price : close > lv.price) :
             (useWick ? low  <= lv.price : close < lv.price)
        if sweep
            lv.swept := true
            line.set_x2(lv.ln, bar_index)
            if dimSwept
                line.set_color(lv.ln, color.new(lv.col, 50))
                line.set_style(lv.ln, line.style_dotted)
            if keepSwept == false
                line.delete(lv.ln)
            else if markSweep
                lv.mk := label.new(bar_index, lv.price, "✕",
                     style     = lv.isHigh ? label.style_label_down : label.style_label_up,
                     color     = color.new(lv.col, 30),
                     textcolor = color.white, size = size.tiny)
        else
            line.set_x2(lv.ln, bar_index)
    i += 1

// ============================================================
//  ÖNCEKİ GÜN HIGH/LOW
//  Gün içinde high/low ve oluştukları bar takip edilir;
//  yeni günde çizgi, ekstremin oluştuğu bardan (iğneden) sağa çizilir
//  (Sadece 1D ve altı zaman dilimlerinde çalışır)
// ============================================================
t        = time("D")
isNewDay = na(t[1]) ? false : (t != t[1])

var float curHigh    = na
var int   curHighBar = na
var float curLow     = na
var int   curLowBar  = na

var line  pdhLine = na
var line  pdlLine = na
var label pdhLbl  = na
var label pdlLbl  = na
var label pdhMark = na
var label pdlMark = na
var float pdhPrice = na
var float pdlPrice = na
var bool  pdhSwept = false
var bool  pdlSwept = false

if isNewDay
    // Önceki günü kapat: takip edilen ekstremleri PDH/PDL'ye çevir
    if showPDHL and pdAllowed and not na(curHigh) and not na(curLow) and withinHistory
        if not na(pdhLine)
            line.delete(pdhLine)
        if not na(pdlLine)
            line.delete(pdlLine)
        if not na(pdhLbl)
            label.delete(pdhLbl)
        if not na(pdlLbl)
            label.delete(pdlLbl)
        if not na(pdhMark)
            label.delete(pdhMark)
        if not na(pdlMark)
            label.delete(pdlMark)
        pdhMark := na
        pdlMark := na
        pdhPrice := curHigh
        pdlPrice := curLow
        pdhSwept := false
        pdlSwept := false
        pdhLine := line.new(curHighBar, curHigh, bar_index, curHigh, color = colPDH, width = pdWidth)
        pdlLine := line.new(curLowBar,  curLow,  bar_index, curLow,  color = colPDL, width = pdWidth)
        if showPDLabel
            pdhLbl := label.new(bar_index, curHigh, "PDH", style = label.style_label_left,
                 color = transp, textcolor = colPDH, size = size.tiny)
            pdlLbl := label.new(bar_index, curLow,  "PDL", style = label.style_label_left,
                 color = transp, textcolor = colPDL, size = size.tiny)
    // Yeni günü başlat
    curHigh    := high
    curHighBar := bar_index
    curLow     := low
    curLowBar  := bar_index
else
    if na(curHigh) or high > curHigh
        curHigh    := high
        curHighBar := bar_index
    if na(curLow) or low < curLow
        curLow    := low
        curLowBar := bar_index

if showPDHL and pdAllowed and not na(pdhLine)
    if not pdhSwept
        bool sw = useWick ? high >= pdhPrice : close > pdhPrice
        if sw
            pdhSwept := true
            line.set_x2(pdhLine, bar_index)
            if dimSwept
                line.set_color(pdhLine, color.new(colPDH, 50))
                line.set_style(pdhLine, line.style_dotted)
            if markSweep
                pdhMark := label.new(bar_index, pdhPrice, "✕", style = label.style_label_down,
                     color = color.new(colPDH, 30), textcolor = color.white, size = size.tiny)
        else
            line.set_x2(pdhLine, bar_index)
            if not na(pdhLbl)
                label.set_xy(pdhLbl, bar_index, pdhPrice)

if showPDHL and pdAllowed and not na(pdlLine)
    if not pdlSwept
        bool sw = useWick ? low <= pdlPrice : close < pdlPrice
        if sw
            pdlSwept := true
            line.set_x2(pdlLine, bar_index)
            if dimSwept
                line.set_color(pdlLine, color.new(colPDL, 50))
                line.set_style(pdlLine, line.style_dotted)
            if markSweep
                pdlMark := label.new(bar_index, pdlPrice, "✕", style = label.style_label_up,
                     color = color.new(colPDL, 30), textcolor = color.white, size = size.tiny)
        else
            line.set_x2(pdlLine, bar_index)
            if not na(pdlLbl)
                label.set_xy(pdlLbl, bar_index, pdlPrice)

// ============================================================
//  NWOG / NDOG  (Sadece 1H ve altı zaman dilimlerinde çalışır)
//  - NDOG: Pazartesi (yeni hafta) çizilmez, çünkü NWOG ile aynı yerde olur
//  - Tarih etiketi: işlem gününün ORTASINA (+12s) denk gelen zaman,
//    sembolün borsa saat diliminde formatlanır. Böylece günlük mum
//    bir önceki akşam açılsa bile tarih doğru güne yazılır.
// ============================================================
[dClose1, dOpen] = request.security(syminfo.tickerid, "D", [close[1], open],
     lookahead = barmerge.lookahead_on)
[wClose1, wOpen] = request.security(syminfo.tickerid, "W", [close[1], open],
     lookahead = barmerge.lookahead_on)

tw         = time("W")
isNewWeek  = na(tw[1]) ? false : (tw != tw[1])

halfDay = 43200000   // 12 saat (ms) - işlem gününün ortasına kaydırma

if isNewDay and not isNewWeek and showNDOG and gapAllowed and not na(dClose1) and not na(dOpen) and withinHistory
    ndogTxt = str.format_time(t + halfDay, "dd.MM", syminfo.timezone) + " | NDOG"
    addGap(ndogs, dClose1, dOpen, colNDOG, showCE, colCE, maxNDOG, ndogTxt, showGapLbl, lblColNDOG)

if isNewWeek and showNWOG and gapAllowed and not na(wClose1) and not na(wOpen)
    wEnd    = tw + 5 * 86400000
    nwogTxt = str.format_time(tw + halfDay, "dd.MM", syminfo.timezone) + " - " + str.format_time(wEnd + halfDay, "dd.MM", syminfo.timezone) + " | NWOG"
    addGap(nwogs, wClose1, wOpen, colNWOG, showCE, colCE, maxNWOG, nwogTxt, showGapLbl, lblColNWOG)

extendGaps(ndogs, true)
extendGaps(nwogs, true)

// ============================================================
//  SMT DIVERGENCE  --  (KAPALI: açmak için aşağıdaki yorumları kaldırın)
// ============================================================
// compHigh = request.security(smtFinalSym, timeframe.period, high)
// compLow  = request.security(smtFinalSym, timeframe.period, low)
// smtName  = request.security(smtFinalSym, timeframe.period, syminfo.ticker)
//
// phVal = ta.pivothigh(high, smtLen, smtLen)
// plVal = ta.pivotlow(low,  smtLen, smtLen)
//
// var float lastPH     = na
// var float lastCompPH = na
// var int   lastPHbar  = na
// var float lastPL     = na
// var float lastCompPL = na
// var int   lastPLbar  = na
//
// if showSMT
//     if not na(phVal)
