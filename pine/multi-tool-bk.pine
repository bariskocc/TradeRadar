// ============================================================
//  EMA'LAR
// ============================================================
ema20  = ta.ema(close, lenE20)
ema50  = ta.ema(close, lenE50)
ema100 = ta.ema(close, lenE100)
ema200 = ta.ema(close, lenE200)

plot(showE20  and emaAllowed ? ema20  : na, "EMA 20",  color = colE20,  linewidth = 1)
plot(showE50  and emaAllowed ? ema50  : na, "EMA 50",  color = colE50,  linewidth = 1)
plot(showE100 and emaAllowed ? ema100 : na, "EMA 100", color = colE100, linewidth = 1)
plot(showE200 and emaAllowed ? ema200 : na, "EMA 200", color = colE200, linewidth = 1)

// ============================================================
//  TRADING RULES PANELİ
// ============================================================

grpRules = "Trading Rules"
showRules = input.bool(true, "Trading Rules panelini göster", group = grpRules)

var table rulesTable = table.new(
     position.top_right,
     1,
     8,
     bgcolor = color.new(color.black, 100),
     border_width = 0)

if barstate.islast
    if showRules

        // ====================================================
        // BAŞLIK
        // ====================================================

        table.cell(
             rulesTable, 0, 0,
             "🧠 TRADING RULES",
             text_color = color.black,
             text_size = size.normal,
             text_halign = text.align_left,
             text_formatting = text.format_bold)

        // ====================================================
        // KURALLAR
        // ====================================================

        table.cell(
             rulesTable, 0, 1,
             "🔴 Setup yoksa → TRADE YOK",
             text_color = color.red,
             text_size = size.small,
             text_halign = text.align_left,
             text_formatting = text.format_bold)

        table.cell(
             rulesTable, 0, 2,
             "🔴 Confirmation yoksa → GİRİŞ YOK",
             text_color = color.red,
             text_size = size.small,
             text_halign = text.align_left,
             text_formatting = text.format_bold)

        table.cell(
             rulesTable, 0, 3,
             "🔴 Loss'u geri alma → İNTİKAM TRADE YOK",
             text_color = color.red,
             text_size = size.small,
             text_halign = text.align_left,
             text_formatting = text.format_bold)

        table.cell(
             rulesTable, 0, 4,
             "🔴 SMT tek başına değil → CISD / MSS",
             text_color = color.red,
             text_size = size.small,
             text_halign = text.align_left,
             text_formatting = text.format_bold)

        table.cell(
             rulesTable, 0, 5,
             "🟡 Bölgeye → RETEST bekle",
             text_color = color.orange,
             text_size = size.small,
             text_halign = text.align_left,
             text_formatting = text.format_bold)

        table.cell(
             rulesTable, 0, 6,
             "🟢 Trade kaçırmak > kötü trade",
             text_color = color.lime,
             text_size = size.small,
             text_halign = text.align_left,
             text_formatting = text.format_bold)

    else
        table.clear(rulesTable, 0, 0, 0, 6)